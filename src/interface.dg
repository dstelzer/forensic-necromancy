%% This is where we’re going to haphazardly define our whole user interface
%% First, an OPTIONS menu, because versalink, automap, and linkbar all have options

(understand command [options])
(perform [options])
	(div @meta) {
		(exhaust) { *(option paragraph) (par) }
	}

%% Now, the status bars (top and inline)

%% For class fullstatus see platform/

(top status bar)
	~(interpreter supports status bar)
	%% Don’t even try
(top status bar)
	(if) (interpreter supports links) (then) %% Include meta verbs, which need an extra line
		($Extra = 1)
	(else)
		($Extra = 0)
	(endif)
	(if) (map enabled) (then) %% Status bar map
		(map of current layer needs $N lines)
		($N plus 2 into $Np2)
		($Np2 plus $Extra into $Total)
		(if) (dreaming) (then) %% Change the color of the status bar if possible to signal that something is different (see platform/ for detail)
			(status bar @fulldream with height $Total) {
				(automap)
				(if) ($Extra = 1) (then) (meta verbs) (endif)
				(story progress)
			}
		(else)
			(status bar @fullstatus with height $Total) {
				(automap)
				(if) ($Extra = 1) (then) (meta verbs) (endif)
				(story progress)
			}
		(endif)
	(else)
		(2 plus $Extra into $Total) %% Headline, progress
		(if) (dreaming) (then)
			(status bar @fulldream with height $Total) {
				(top right)
				(location headline) %% Default headline
				(if) ($Extra = 1) (then) (meta verbs) (endif)
				(story progress)
			}
		(else)
			(status bar @fullstatus with height $Total) {
				(top right)
				(location headline) %% Default headline
				(if) ($Extra = 1) (then) (meta verbs) (endif)
				(story progress)
			}
		(endif)
	(endif)

(style class @topright)
	height: 1em;
	float: right;
	width: 7ch;

(top right)
	(div @topright) (top right reminder)

(top right reminder)
	(#n-ziqqurat is unvisited) %% No reminder until you’ve dreamed the first time
(top right reminder)
	(dreaming)
	(space 1) Memory %% One letter shorter than “Present”
(top right reminder)
	Present

(redraw status bar)
	(set appropriate color scheme)
	(top status bar)
	(give the tutorial) %% world.dg
	(draw automap outside of status bar if applicable) %% automap.dg
	(link bar) %% linkbar.dg
	%% If we did neither of the above, show the exits separately
	(show exits if applicable)

(set appropriate color scheme)
	(dreaming)
	(set memory world colors)
(set appropriate color scheme)
	(set real world colors)

%% Color scheme only applies on Å-machine; do nothing on other platforms
(set real world colors)
(set memory world colors)

%% And the exits bar if needed - exits aren’t given in room descriptions, so if there’s no map, and no suggestions bar, we add a fallback

(show exits if applicable)
	(suggestions enabled) (or) (map enabled)
	%% Do nothing
(show exits if applicable)
	(current room $Room)
	(collect $Dir)
		(from $Room go $Dir to $Next)
		{ (room $Next) (or) (door $Next) }
	(into $ExitList)
	(span @bold) { Exits: } (link list $ExitList)

%% Now, what are those “meta verbs”?

(style class @metabar)
	width: 100\%;
	%% Z-machine will assume 1em height which is what we want
	%% Web will assume auto height which is also what we want
	font-size: smaller;
	text-align: center;
	margin-top: 0.33em;
	margin-bottom: 0.33em;

(meta verbs with margin $N)
	(div @metabar) {
		(space $N)
		(link) undo
		(bullet) (link) save
		(bullet) (link) restore
		(bullet) (link) about
		(bullet) (link) nudge
	}
%% For this game, this will always be exactly 37 characters long
(meta verbs)
	~(interpreter supports text alignment)
	(current div width $Width)
	($Width minus 37 into $DoubleMargin)
	($DoubleMargin divided by 2 into $Margin)
	(meta verbs with margin $Margin)
(meta verbs) %% Fallback
	(meta verbs with margin 0)

%% And an experimental progress bar: TODO is it good?

(style class @progress)
	font-size: smaller;
	width: 100\%;
	margin-bottom: 0.5em;

(story progress)
	(current score $Score)
	(maximum score $Max)
	(div @progress) (progress bar $Score of $Max)

%% For @meta and @tutorial see platform/

%% Pause implementation taken from Wise-Woman’s Dog

(style class @pause)
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: center;

(pause)
	(if) (interpreter supports links) (then) %% Another link could be clicked during this process, so we have to be ready for this
		*(repeat forever)
		(if) (interpreter supports inline status bar) (then) %% An inline status bar will disappear on the next turn, so it’s ideal
			(inline status bar @pause) {
				(link []) { \[\[Continue\]\] }
			}
		(else) %% Otherwise, try to make it look okay in the transcript
			(div @pause) { (link []) { \* \* \* } }
		(endif)
		(if) (in debugger) (then) (line) > (endif) %% Skein requires this
		(get input $Words) %% Just wait for a link to be clicked, then continue
		(if) *(understand $Words as $Action) (command $Action) (then) %% These can sometimes be produced by links in the status bar, so we should acknowledge that and process them instead of proceeding with the game - but we explicitly don’t handle ambiguity here, we just go with the first possible interpretation
			(try $Action)
			(fail)
		(endif)
	(else) %% No links, so we can do a standard “wait for any key” (which is the standard way to handle this on Z-machine)
		(div @pause) {
	%% Currently the “press any key...” comes from the content warnings so we don’t need to say it again
	%%		(select)
	%%			\* \* \* \[ Press any key to continue. \] \* \* \*
	%%		(or)
				\* \* \*
	%%		(stopping)
		}
		(any key)
		(par)
	(endif)

%% Similarly, italics

%% We want nested italics to alternate between italic and straight, so we need two classes both with the emphasis role
(style class @emph)
	font-style: italic;
	aria-role: emphasis;
(style class @emphemph)
	font-style: normal;
	aria-role: emphasis;

%% Display some text “emphasized”: normally in italics, but upright if we’re already inside another italic block
(emph $Closure)
	(if) (currently italic) (then)
		(now) ~(currently italic)
		(span @emphemph) (query $Closure)
		(now) (currently italic)
	(else)
		(now) (currently italic)
		(span @emph) (query $Closure)
		(now) ~(currently italic)
	(endif)

%% Hints

(define resource @hints) hints.html; an HTML file of hints.
(understand command [hints])
(perform [hints])
	(div @meta) {
		(if) (interpreter supports links) (then)
			(link resource @hints) { Click here to open hints in a new tab. }
		(else)
			For hints, see the file (span @command) { hints.html } included in the download.
		(endif)
	}

(after [nudge]) %% Little tutorial
	~(taught hints)
	(div @tutorial) {
		If you’re really stuck on a puzzle, you can also check the
		(if) (interpreter supports links) (then) %% If we have proper links, don’t make the player click an extra time
			(span @link) { (link resource @hints) hints }
		(else)
			({hints})
		(endif)
		.
	}
	(now) (taught hints)

%% Score system: puzzles and vignettes
%% Without editing stdlib we have to work around this a bit :(

(new current score $N)
	(accumulate 1)
		{ *(puzzle $Obj) (solved $Obj) }
		(or)
		{ *(vignette $Room) ($Room is visited) }
	(into $N)

(maximum score $N)
	(accumulate 1)
		*(puzzle $)
		(or)
		*(vignette $)
	(into $N)

(early on every tick) %% We can’t make (current score $) not a global without editing the library :(
	(new current score $N)
	(now) (current score $N)

(scoring enabled)

%% Duplicating a bunch of stdlib code to avoid editing stdlib itself
%% But I want to add links

(report score change)
	(reported score is $Reported)
	(current score $Score)
	(if) ($Score < $Reported) (then)
		($Reported minus $Score into $Diff)
		(div @meta) {
			\( Your ({score}) has gone down by (spell out $Diff)
			point (if) ~(1 = $Diff) (then) (no space) s (endif)
			. \)
		}
		(par)
		(now) (reported score is $Score)
	(elseif) ($Score > $Reported) (then)
		($Score minus $Reported into $Diff)
		(div @meta) {
			\( Your ({score}) has gone up by (spell out $Diff)
			point (if) ~(1 = $Diff) (then) (no space) s (endif)
			. \)
		}
		(par)
		(now) (reported score is $Score)
	(endif)

%% This one we edit to add a progress bar and a hint at FULL SCORE
(perform [score])
	(scoring enabled)
	(current score $Score)
	(div @meta) {
		You currently have (spell out $Score)
		(if) ($Score = 1) (then) point (else) points (endif)
		(if) (maximum score $Max) (then)
			out of a maximum of (spell out $Max)
		(endif)
		. (line)
		(progress bar $Score of $Max)
		Use (command link {FULL SCORE}) to see the details.
	}

%% And now something stdlib doesn’t do
(understand command [full score])
(grammar [full] for [full score])
(perform [full score])
	(current score 0)
	(div @meta) { You haven’t scored any points yet. }
(perform [full score])
	(collect $Puzzle)
		*(puzzle $Puzzle)
		(solved $Puzzle)
	(into $PList)
	(length of $PList into $PNum)
	(collect $Vignette)
		*(vignette $Vignette)
		($Vignette is visited)
	(into $VList)
	(length of $VList into $VNum)
	(current score $Score)
	(maximum score $Max)
	(div @meta) {
		You’ve solved (spell out $PNum) puzzle
		(if) ~($PNum = 1) (then) (no space) s (endif)
		\( (the-listing $PList) \)
		(if) (nonempty $VList) (then) %% Can’t have empty PList and nonempty VList
			and visited (spell out $VNum) memor (no space)
			(if) ~($PNum = 1) (then) ies (else) y (endif)
			\( (the-listing $VList) \)
		(endif)
		, giving you (spell out $Score) point
		(if) ~($PNum = 1) (then) (no space) s (endif)
		out of (spell out $Max) .
	}

(game over option)
	review your (link) SCORE ,
(parse game over [full/score])
	(perform [full score])
(parse game over [full score])
	(perform [full score])

%% A bit of extra guidance on overall goals
(after [nudge])
	~(any vignette is unvisited)
	(par) Your overall goal is to put together a compelling narrative: something that will draw attention to your thesis.
	Right now, that means
	(if) (#n-execution is visited) (then)
		finding as many memories as you can.
	(elseif) (#bones-n is examined) (then)
		using your necromantic skills to dig up some ancient memories.
	(else)
		getting into the dig site and finding some human remains.
	(endif)

%% Bypassing puzzles, for testing

(understand [bypass | $Words] as [bypass $Obj])
	(determine object $Obj)
		*(puzzle $Obj)
	(from words)
		*(dict $Obj)
	(matching all of $Words)
~(refuse [bypass $])
(prevent [bypass ~(puzzle $Obj)])
	(The $Obj) (is $Obj) not a puzzle. How did you manage that?
(prevent [bypass (solved $Obj)])
	(The $Obj) puzzle (is $Obj) already solved.
(perform [bypass $Obj])
	(exhaust) {
		*($Obj requires $Parent)
		~(solved $Parent)
		\( (the $Obj) requires (the $Parent), so doing that first \) (line)
		(try [bypass $Parent])
	}
	(bypass $Obj)
(unlikely [bypass $Obj]) %% Avoid disambiguation woes
	~($Obj is in scope)

%% And finally, a check I include in every game (though not for final release)

(startup)
	(in debugger)
	(exhaust) {
		*(object $Obj)
		~($Obj is in room $)
		~($Obj is #partof $) %% This will get reported on the parent already
		~(supposed to be nowhere $Obj)
		~(attracted to any room $Obj)
		(log) { (span @bold) {Warning:} $Obj \( (the $Obj) \) is not in any room! }
	}

(supposed to be nowhere *(room $))
(supposed to be nowhere *(direction $))
(supposed to be nowhere *(relation $))
(supposed to be nowhere #darkness) %% Not actually used in this game

(attracted to any room $Obj)
	*(room $Room)
	($Room attracts $Obj) %% Needs bound first param for optimizer

(in debugger) (fail) %% Set in lib/dialog/debug/flag.dg so we can check it in various places
