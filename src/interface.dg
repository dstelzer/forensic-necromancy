%% This is where we’re going to haphazardly define our whole user interface
%% First, an OPTIONS menu, because versalink, automap, and linkbar all have options

(understand command [options])
(perform [options])
	(div @meta) {
		(exhaust) { *(option paragraph) (par) }
	}

%% Now, the status bars (top and inline)

%% For class fullstatus see platform/

(top status bar)
	~(interpreter supports status bar)
	%% Don’t even try
(top status bar)
	(if) (map enabled) (cartography enabled) (then) %% Status bar map
		(map of current layer needs $N lines)
		($N plus 1 into $Np1)
		(if) (dreaming) (then) %% Change the color of the status bar if possible to signal that something is different (see platform/ for detail)
			(status bar @fulldream with height $Np1) {
				(automap)
				(meta verbs)
			}
		(else)
			(status bar @fullstatus with height $Np1) {
				(automap)
				(meta verbs)
			}
		(endif)
	(else)
		(if) (dreaming) (then)
			(status bar @fulldream with height 2) {
				(status headline) %% Default headline
				(meta verbs)
			}
		(else)
			(status bar @fullstatus with height 2) {
				(status headline) %% Default headline
				(meta verbs)
			}
		(endif)
	(endif)

(redraw status bar)
	(top status bar)
	(give the tutorial) %% intro.dg
	(draw automap outside of status bar if applicable) %% automap.dg
	(link bar) %% linkbar.dg
	%% If we did neither of the above, show the exits separately
	(show exits if applicable)

%% And the exits bar if needed - exits aren’t given in room descriptions, so if there’s no map, and no suggestions bar, we add a fallback

(show exits if applicable)
	(suggestions enabled) (or) (map enabled)
	%% Do nothing
(show exits if applicable)
	(current room $Room)
	(collect $Dir)
		(from $Room go $Dir to $Next)
		{ (room $Next) (or) (door $Next) }
	(into $ExitList)
	(span @bold) { Exits: } (link list $ExitList)

%% Now, what are those “meta verbs”?

(style class @metabar)
	width: 100\%;
	font-size: smaller;
	text-align: center;
	margin-top: 0.33em;
	margin-bottom: 0.33em;

(meta verbs with margin $N)
	(div @metabar) {
		(space $N)
		(link) undo
		(bullet) (link) save
		(bullet) (link) restore
		(bullet) (link resource @hints) hints
		(bullet) (link) about
	}
%% For this game, this will always be exactly 37 characters long
(meta verbs)
	(interpreter supports text alignment)
	(meta verbs with margin 0)
(meta verbs)
	~(interpreter supports text alignment)
	(current div width $Width)
	($Width minus 37 into $DoubleMargin)
	($DoubleMargin divided by 2 into $Margin)
	(meta verbs with margin $Margin)

%% For @meta and @tutorial see platform/

%% Pause implementation taken from Wise-Woman’s Dog

(style class @pause)
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: center;

(pause)
	(if) (interpreter supports links) (then) %% Links only provide line input, not character input, so we need to use (get input $) for this
		*(repeat forever)
		(if) (interpreter supports inline status bar) (then) %% An inline status bar will disappear on the next turn, so it’s ideal
			(inline status bar @pause) {
				(link []) { \[\[Continue\]\] }
			}
		(else) %% Otherwise, try to make it look okay in the transcript
			(div @pause) { (link) { \* \* \* } }
		(endif)
		(if) (in debugger) (then) (line) > (endif) %% Skein requires this
		(get input $Words) %% Just wait for a link to be clicked, then continue
		(if) *(understand $Words as $Action) (command $Action) (then) %% These can sometimes be produced by links in the menu, so we should acknowledge that and process them instead of proceeding with the game - but we explicitly don’t handle ambiguity here, we just go with the first possible interpretation
			(try $Action)
			(fail)
		(endif)
	(else) %% No links, so we can do a standard “wait for any key” (which is the standard way to handle this on Z-machine)
		(any key)
		(par)
	(endif)

%% Similarly, italics

%% We want nested italics to alternate between italic and straight, so we need two classes both with the emphasis role
(style class @emph)
	font-style: italic;
	aria-role: emphasis;
(style class @emphemph)
	font-style: normal;
	aria-role: emphasis;

%% Display some text “emphasized”: normally in italics, but upright if we’re already inside another italic block
(emph $Closure)
	(if) (currently italic) (then)
		(now) ~(currently italic)
		(span @emphemph) (query $Closure)
		(now) (currently italic)
	(else)
		(now) (currently italic)
		(span @emph) (query $Closure)
		(now) ~(currently italic)
	(endif)

%% And finally, a check I include in every game (though not for final release)

(startup)
	(in debugger)
	(exhaust) {
		*(object $Obj)
		~($Obj is in room $)
		~(supposed to be nowhere $Obj)
		~(attracted to any room $Obj)
		(log) { (span @bold) {Warning:} $Obj \( (the $Obj) \) is not in any room! }
	}

(supposed to be nowhere *(room $))
(supposed to be nowhere *(direction $))
(supposed to be nowhere *(relation $))
(supposed to be nowhere #darkness)

(attracted to any room $Obj)
	*(room $Room)
	($Room attracts $Obj)

(in debugger) (fail) %% Set in lib/dialog/debug/flag.dg
