%% This gives us an easy way to enable or disable certain behavior
(in debugger)

%% These are the equivalent of platform/ for building
(style class @fullstatus)
	height: 1em;
(style class @fulldream)
	height: 1em;
(style class @ministatus)
	height: 1em;
(style class @minidream)
	height: 1em;

(interface (italic correction)) %% Used between (emph $) and a closing quotation mark
(italic correction)

(style class @meta)
	font-style: italic;
	margin-top: 1em;
	margin-bottom: 1em;

(style class @tutorial)
	font-style: italic;
	margin-top: 1em;
	margin-bottom: 1em;

(style class @title)
	margin-top: 1em;
	margin-bottom: 1em;

(style class @roomheader)
	margin-top: 1em;

(interface (resources limited))
(resources limited) (fail)

(style class @topic)
	font-style: italic;
