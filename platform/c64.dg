%% Change this if C64 ever supports (status bar $ with height $)
(style class @fullstatus) %% Enough for a very basic automap
	height: 8em;
(style class @fulldream)
	height: 8em;
(style class @ministatus)
	height: 2em;
(style class @minidream)
	height: 2em;

(interface (italic correction)) %% Used between (emph $) and a closing quotation mark
(italic correction) %% C64 uses alternate colors, not true italics

(style class @meta)
	font-style: italic; %% Blue
	margin-top: 1em;
	margin-bottom: 1em;

(style class @tutorial)
	font-style: italic; %% Blue
	margin-top: 1em;
	margin-bottom: 1em;

(style class @title)
	margin-top: 1em;
	margin-bottom: 1em;

(style class @roomheader)
	margin-top: 1em;

(interface (resources limited))
(resources limited) %% Resources are very limited!

(after [options])
	(div @meta) {
		\( Warning: the automap is rather slow on a Commodore 64, and not recommended unless you have an emulator with warp speed. \)
	}

(pause) %% Do nothing, it’s slow enough already!
