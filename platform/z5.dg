(style class @fullstatus)
	height: 2em;
(style class @ministatus)
	height: 2em;

(style class @fulldream)
	height: 2em;
	text-decoration: none; %% Not reversed
(style class @minidream)
	height: 2em;
	text-decoration: none;

(interface (italic correction)) %% Used between (emph $) and a closing quotation mark
(italic correction) (space 1)

(style class @meta)
	font-style: italic;
	margin-top: 1em;
	margin-bottom: 1em;

(style class @tutorial)
	font-style: italic;
	margin-top: 1em;
	margin-bottom: 1em;

(style class @title)
	margin-top: 1em;
	margin-bottom: 1em;

(style class @roomheader)
	margin-top: 1em;

(interface (resources limited))
(resources limited) (fail)
