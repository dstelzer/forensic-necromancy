(style class @fullstatus)
	height: auto;
(style class @ministatus)
	height: auto;

(style class @fulldream)
	height: auto;
(style class @ministatus)
	height: auto;

%% Color scheme!
%% Currently just Å-machine default for the real world
(style class @normal)
	--theme-darkest: \#000000;
	--theme-dark: \#222222;
	--theme-medium: \#888888;
	--theme-light: \#cccccc;
	--theme-lightest: \#eeeeee;
	--accent-dark: \#c95c03;
	--accent-light: \#fc8f36;

%% Sepia tones
(style class @memory) %% https://supercolorpalette.com/
	--theme-darkest: \#190A01;
	--theme-dark: \#6E4114;
	--theme-medium: \#C57A32;
	--theme-light: \#F9CAA4;
	--theme-lightest: \#F9CAA4; %% same as -light
	--accent-dark: \#c95c03;
	--accent-light: \#fc8f36;

(set real world colors)
	(body style @normal)
(set memory world colors)
	(body style @memory)

(interface (italic correction)) %% Used between (emph $) and a closing quotation mark
(italic correction)

(backend-specific options tutorial) You can find some other options in the ≡ menu at the top right corner of the page.

(style class @meta)
	margin-top: 1em;
	margin-bottom: 1em;
	margin-left: 1em;
	margin-right: 1em;
	font-family: sans-serif;

(style class @tutorial)
	margin-top: 1em;
	margin-bottom: 1em;
	margin-left: 1em;
	margin-right: 1em;
	font-family: sans-serif;

(style class @title)
	margin-top: 1.5em;
	margin-bottom: 1em;
	text-align: center;
	margin-left: 3em;
	margin-right: 3em;

(style class @roomheader)
	margin-top: .5em;
	font-size: 1.2em;

(style class @gameover)
	font-weight: bold;
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: center;

(interface (resources limited))
(resources limited) (fail)
