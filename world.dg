(from * go #up to #west)

(before [leave * #west])
	(#cart is #in *)
	(current player $Player)
	~($Player is #on #cart)
	(first try [enter #cart])

(prevent [leave * #west])
	~(upper rope connected)
	(current player $Player)
	~($Player is #on #cart)
